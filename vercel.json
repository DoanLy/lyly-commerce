{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path(.*)",
      "destination": "/api?__path=:path"
    },
    {
      "source": "/((?!api|assets).*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
